{
  "name": "@multi-site-cms/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared non-secret platform constants, public environment parsing, and web security headers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./revalidation": {
      "types": "./src/revalidation.ts",
      "default": "./src/revalidation.ts"
    },
    "./security-headers": {
      "types": "./security-headers.d.mts",
      "default": "./security-headers.mjs"
    },
    "./embeds": {
      "types": "./src/embeds.ts",
      "default": "./src/embeds.ts"
    },
    "./doc-outline": {
      "types": "./src/doc-outline.ts",
      "default": "./src/doc-outline.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@multi-site-cms/validation": "workspace:*"
  },
  "devDependencies": {
    "@multi-site-cms/eslint-config": "workspace:*",
    "@multi-site-cms/tsconfig": "workspace:*",
    "vitest": "5.0.5"
  }
}
