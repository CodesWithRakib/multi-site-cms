NEXT_PUBLIC_APP_URL=http://localhost:5001

# Server-only. Shared with the API; authenticates POST /api/revalidate
# (header x-revalidate-secret). Without it the webhook answers 503.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Public editorial address used by /contact (mailto). When unset the page
# shows no address and no email form.
NEXT_PUBLIC_CONTACT_EMAIL=
