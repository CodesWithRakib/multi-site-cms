[TEMPLATE]
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Route prefix without a leading slash. Controllers declare resource paths only.
API_PREFIX=api/v1

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5000,http://localhost:5001,http://localhost:5002,http://localhost:50001,http://localhost:50002

# Local development database from infrastructure/docker/docker-compose.yml.
# Production values belong in the hosting provider's secret manager, never here.
DATABASE_URL=postgresql://multi_site_cms:multi_site_cms_dev@localhost:5432/multi_site_cms

# 0 for direct local connections; set 1 when running behind one trusted proxy.
TRUST_PROXY=0

# debug | info | warn | error | silent. Logs are single-line JSON.
LOG_LEVEL=info

# Maximum request body size for JSON and urlencoded parsers.
BODY_LIMIT=1mb

# OpenAPI is always available outside production. In production it is opt-in,
# because the API has no authentication yet.
DOCS_ENABLED=false

# Integration tests only. The harness refuses any database whose name does not
# end in "_test" because it drops and recreates the public schema.
TEST_DATABASE_URL=postgresql://multi_site_cms:multi_site_cms_dev@localhost:5432/multi_site_cms_test

# Storage Provider: 'local' | 'cloudinary'
# 'cloudinary' requires either the three CLOUDINARY_* values below or
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>.
# There are no built-in credentials; boot fails if they are missing.
STORAGE_PROVIDER=local
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# HMAC key for draft preview tokens (min 32 chars). Required in production.
# When unset outside production a random per-process key is used, so preview
# links stop working after an API restart. Generate: openssl rand -hex 32
PREVIEW_TOKEN_SECRET=

# Shared with every public site (min 16 chars). Sent as x-revalidate-secret to
# POST <site>/api/revalidate. When unset, on-demand revalidation is skipped.
REVALIDATE_SECRET=

# Optional revalidation target override, siteKey=url pairs (ADR-0026).
# Without it the API uses https://<verified primary domain> of each site.
# Local example: travel-blog=http://localhost:5001,air-sports=http://localhost:5002
SITE_REVALIDATE_URLS=

# Public base URL of this API including the prefix; used for absolute media
# and preview links. Required (and not localhost) in production.
API_BASE_URL=http://localhost:4000/api/v1

# Development only: password for `pnpm --filter @multi-site-cms/api db:seed:admins`,
# which creates missing site Admins (never a Super Admin, never in production).
# At least 12 characters. Leave empty in every shared environment.
DEV_SITE_ADMIN_PASSWORD=
