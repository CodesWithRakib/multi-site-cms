NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Local development database from infrastructure/docker/docker-compose.yml.
# Production values belong in the hosting provider's secret manager, never here.
DATABASE_URL=postgresql://multi_site_cms:multi_site_cms_dev@localhost:5432/multi_site_cms

# 0 for direct local connections; set 1 when running behind one trusted proxy.
TRUST_PROXY=0

# Integration tests only. The harness refuses any database whose name does not
# end in "_test" because it drops and recreates the public schema.
TEST_DATABASE_URL=postgresql://multi_site_cms:multi_site_cms_dev@localhost:5432/multi_site_cms_test
