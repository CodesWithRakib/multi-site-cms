[TEMPLATE]
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Route prefix without a leading slash. Controllers declare resource paths only.
API_PREFIX=api/v1

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5000,http://localhost:5001,http://localhost:5002,http://localhost:50001,http://localhost:50002

# Local development database from infrastructure/docker/docker-compose.yml.
# Production values belong in the hosting provider's secret manager, never here.
DATABASE_URL=postgresql://multi_site_cms:multi_site_cms_dev@localhost:5432/multi_site_cms

# 0 for direct local connections; set 1 when running behind one trusted proxy.
TRUST_PROXY=0

# debug | info | warn | error | silent. Logs are single-line JSON.
LOG_LEVEL=info

# Maximum request body size for JSON and urlencoded parsers.
BODY_LIMIT=1mb

# OpenAPI is always available outside production. In production it is opt-in,
# because the API has no authentication yet.
DOCS_ENABLED=false

# Integration tests only. The harness refuses any database whose name does not
# end in "_test" because it drops and recreates the public schema.
TEST_DATABASE_URL=postgresql://multi_site_cms:multi_site_cms_dev@localhost:5432/multi_site_cms_test

# Storage Provider: 'local' | 'cloudinary'
STORAGE_PROVIDER=local
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
