{
  "name": "@multi-site-cms/api",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized NestJS API for the multi-site publishing platform.",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
    "db:migration:run": "typeorm -d dist/database/data-source.js migration:run",
    "db:migration:revert": "typeorm -d dist/database/data-source.js migration:revert",
    "db:migration:show": "typeorm -d dist/database/data-source.js migration:show",
    "db:migration:generate": "typeorm -d dist/database/data-source.js migration:generate --pretty",
    "db:seed:dev": "node dist/database/seeds/development.seed.js",
    "db:seed:content": "node dist/database/seeds/content.seed.js",
    "db:seed:admins": "node dist/database/seeds/provision-site-admins.js",
    "bootstrap:platform": "node dist/database/cli/bootstrap-platform.js",
    "bootstrap:super-admin": "node dist/database/cli/bootstrap-super-admin.js",
    "seed:production-content": "node dist/database/cli/seed-production-content.js",
    "db:cleanup:generated-analytics": "node dist/database/cli/remove-generated-analytics.js"
  },
  "dependencies": {
    "@multi-site-cms/types": "workspace:*",
    "@multi-site-cms/validation": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@multi-site-cms/eslint-config": "workspace:*",
    "@multi-site-cms/tsconfig": "workspace:*",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15"
  }
}
