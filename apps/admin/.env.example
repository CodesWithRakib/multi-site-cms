NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:5000

# Production only: same-origin API proxy (see docs/deployment/production-runbook.md).
# Origin of the API, e.g. https://api.example.com. When set, /api/v1/* on the
# admin origin is forwarded there and NEXT_PUBLIC_API_URL must be
# <admin origin>/api/v1. Leave empty locally.
API_PROXY_TARGET=
